            "location": {
              "title": "Пункт меню",
              "type": "string"
            },
            "nodes": {
              "title": "Виртуальные ноды",
              "patternProperties": {
                "^[a-zA-Z][a-zA-Z0-9_-]*(\\.[a-zA-Z][a-zA-Z0-9_-]*)*$": {
                  "type": "object",
                  "properties": {
                    "title": {
                      "type": "string",
                      "title": "Название"
                    },
                    "symbol": {
                      "type": "string",
                      "title": "Символ"
