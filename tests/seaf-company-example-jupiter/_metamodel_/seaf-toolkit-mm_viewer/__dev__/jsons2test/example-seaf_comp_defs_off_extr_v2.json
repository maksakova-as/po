                        "Модифицируется",
                        "Используется",
                        "Выводится из эксплуатации"
                      ]
                    },
                    "changes": {
                      "title": "Описание изменений",
                      "type": "string"
                    },
                    "location": {
                      "title": "Размещение",
                      "enum": [
                        "Внутренняя",
                        "Внешняя"
                      ]
