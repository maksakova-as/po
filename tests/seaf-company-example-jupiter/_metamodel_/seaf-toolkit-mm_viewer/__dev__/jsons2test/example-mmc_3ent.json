{
  "entities": {
    "seaf.company.ba.products": {
      "title": "Продукты",
      "description": "Товары, услуги или сервисы компании, созданные или адаптированные для использования внешними или внутренними клиентами",
      "schema": {
        "type": "object",
        "patternProperties": {
          "[a-zA-Z0-9_]*(\\.[a-zA-Z0-9_]*)*$": {
            "type": "object",
            "$ref": "#/$defs/seaf.company.shared.defs.lifecycle_stage",
            "allOf": [
              {
                "$ref": "#/$defs/seaf.company.shared.defs.basic_attributes"
              }
            ],
            "properties": {
              "is_part_of": {
                "title": "Ссылка на родительский объект",
                "description": "Используется для задания древовидной структуры объектов",
                "$ref": "#/$rels/seaf.company.ba.products.product"
              },
              "distributed_via": {
                "title": "Распространяется через",
                "description": "Каналы распространения продукта",
                "type": "array",
                "items": {
                  "$ref": "#/$rels/seaf.company.ba.channels.channel"
                }
              },
              "target_clients": {
                "title": "Целевые клиенты",
                "description": "Клиенты, на которых нацелен продукт",
                "type": "array",
                "items": {
                  "$ref": "#/$rels/seaf.company.ba.clients.client"
                }
              }
            }
          }
        }
      },
      "objects": {
        "product": {
          "route": "/",
          "title": "Продукт",
          "symbol": "prd"
        }
      }
    },
    "seaf.company.ba.channels": {
      "title": "Каналы",
      "description": "Канал - это цифровое (web, app) физическое (офис, торговый зал) или смешанное (phygital) пространство Компании, в котором Клиент (внешний и/или внутренний) знакомится, приобретает и пользуется продуктами Компании",
      "schema": {
        "type": "object",
        "patternProperties": {
          "[a-zA-Z0-9_]*(\\.[a-zA-Z0-9_]*)*$": {
            "type": "object",
            "allOf": [
              {
                "$ref": "#/$defs/seaf.company.shared.defs.basic_attributes"
              },
              {
                "$ref": "#/$defs/seaf.company.shared.defs.lifecycle_stage"
              }
            ],
            "properties": {
              "is_part_of": {
                "title": "Ссылка на родительский объект",
                "description": "Используется для задания древовидной структуры объектов",
                "$ref": "#/$rels/seaf.company.ba.channels.channel"
              },
              "type": {
                "title": "Тип канала",
                "enum": [
                  "Цифровой",
                  "Физический",
                  "Phygital"
                ]
              },
              "serves_clients": {
                "title": "Обслуживает клиентов",
                "type": "array",
                "items": {
                  "$ref": "#/$rels/seaf.company.ba.clients.client"
                }
              }
            },
            "required": [
              "type",
              "serves_clients"
            ]
          }
        }
      },
      "objects": {
        "channel": {
          "route": "/",
          "title": "Канал",
          "symbol": "ch"
        }
      }
    },
    "seaf.company.app.services": {
      "title": "Прикладные сервисы",
      "description": "Функциональность приложений, используемая потребителями (пользователями, системами, другими сервисами)",
      "schema": {
        "type": "object",
        "patternProperties": {
          "[a-zA-Z0-9_]*(\\.[a-zA-Z0-9_]*)*$": {
            "type": "object",
            "allOf": [
              {
                "$ref": "#/$defs/seaf.company.shared.defs.basic_attributes"
              },
              {
                "$ref": "#/$defs/seaf.company.shared.defs.lifecycle_stage"
              }
            ],
            "properties": {
              "is_part_of": {
                "title": "Ссылка на родительский объект",
                "description": "Используется для задания древовидной структуры объектов",
                "$ref": "#/$rels/seaf.company.app.services.service"
              },
              "type": {
                "title": "Тип сервиса",
                "enum": [
                  "UI",
                  "API",
                  "AI Agent"
                ]
              }
            }
          }
        }
      },
      "objects": {
        "service": {
          "route": "/",
          "title": "Прикладной сервис",
          "symbol": "srv"
        }
      }
    },
    "seaf.company.shared.defs": {
      "title": "Базовые атрибуты и справочники",
      "schema": {
        "$defs": {
          "seaf.company.shared.defs.basic_attributes": {
            "title": "Базовые атрибуты для всех сущностей",
            "type": "object",
            "properties": {
              "title": {
                "title": "Краткое название",
                "type": "string",
                "description": "Используется в качестве названия объекта в схемах и отчетах"
              },
              "description": {
                "title": "Описание",
                "type": "string",
                "description": "Описание объекта в несколько предложений"
              },
              "external_id": {
                "title": "Внешний идентификатор",
                "type": "string",
                "description": "Идентификатор объекта во внешней системе"
              },
              "comments": {
                "title": "Комментарии",
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "title"
            ]
          },
          "seaf.company.shared.defs.lifecycle_stage": {
            "title": "Этапы жизненного цикла объекта",
            "type": "object",
            "properties": {
              "lifecycle_stage": {
                "title": "Этап ЖЦ",
                "type": "string",
                "enum": [
                  "Идея",
                  "Создается",
                  "Используется и развивается",
                  "Используется",
                  "Выводится из эксплуатации",
                  "В архиве"
                ]
              },
              "affected_area": {
                "$ref": "#/$defs/seaf.change.adr.affects.area"
              }
            }
          },
          "seaf.change.adr.affects.area": {
            "title": "Область эффекта",
            "type": "string",
            "enum": [
              "people",
              "money",
              "resources",
              "time",
              "business",
              "technology",
              "other"
            ]
          }
        }
      }
    }
  }
}
