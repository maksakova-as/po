                    },
                    "rpo": {
                      "title": "RPO (мин)",
                      "type": "integer"
                    },
                    "sla": {
                      "title": "SLA (%)",
                      "type": "number"
                    },
                    "class": {
                      "title": "Класс",
                      "enum": [
                        "BPM (Business Process Management)",
