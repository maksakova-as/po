{
  "entities": {
    "seaf.company.def.attributes": {
      "title": "Базовые атрибуты и справочники",
      "schema": {
        "$defs": {
          "seaf.def.basic_attributes": {
            "required": [
              "title"
            ],
            "properties": {
              "title": {
                "title": "Краткое название",
                "type": "string",
                "description": "Используется в качестве названия объекта в схемах и отчетах"
              },
              "description": {
                "title": "Описание",
                "type": "string",
                "description": "Описание объекта в несколько предложений"
              },
              "external_id": {
                "title": "Внешний идентификатор",
                "type": "string",
                "description": "Идентификатор объекта во внешней системе"
              },
              "comments": {
                "title": "Комментарии",
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "seaf.def.lifecycle_stage": {
            "properties": {
              "lifecycle_stage": {
                "title": "Этап ЖЦ",
                "type": "string",
                "enum": [
                  "Идея в проработке",
                  "Создается",
                  "Тестируется",
                  "Используется и развивается",
                  "Используется",
                  "В архиве"
                ]
              }
            }
          },
          "seaf.company.def.criticality_level": {
            "required": [
              "criticality_level"
            ],
            "properties": {
              "criticality_level": {
                "title": "Уровень критичности",
                "enum": [
                  "Mission Critical",
                  "Business Critical",
                  "Business Operational",
                  "Office Productivity"
                ]
              }
            }
          }
        }
      }
    },
    "seaf.company.def.data_types": {
      "title": "Типы данных",
      "schema": {
        "$defs": {
          "seaf.def.type.date": {
            "oneOf": [
              {
                "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}$"
              },
              {
                "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$"
              },
              {
                "pattern": "^[0-9]{4}Q[1-4]{1}$"
              },
              {
                "pattern": "^[0-9]{4}$"
              }
            ],
            "type": "string"
          }
        }
      }
    },
    "seaf.company.app.systems": {
      "objects": {
        "system": {
          "route": "/",
          "title": "Система",
          "symbol": "system"
        }
      },
      "schema": {
        "$defs": {
          "seaf.company.def.system": {
            "properties": {
              "is_part_of": {
                "title": "Является частью",
                "description": "Родительская система для данной функциональной подсистемы",
                "$ref": "#/$rels/seaf.company.app.systems.system"
              },
              "realizes_it_services": {
                "items": {
                  "$ref": "#/$rels/seaf.company.app.services.service"
                },
                "title": "Реализует ИТ-сервисы",
                "description": "Перечисление сервисов (функциональности), реализуемых данной системой",
                "type": "array"
              },
              "lifecycle_stage": {
                "title": "Этап жизненного цикла",
                "enum": [
                  "Эскиз",
                  "В разработке / приобретение",
                  "Внедрение / Не введена в эксплуатацию",
                  "Опытная эксплуатация",
                  "Промышленная эксплуатация",
                  "Архивная",
                  "Отменена"
                ]
              },
              "target_status": {
                "title": "Целевой статус",
                "enum": [
                  "Целевая",
                  "Не целевая"
                ]
              },
              "location": {
                "title": "Размещение",
                "enum": [
                  "Внутренняя",
                  "Внешняя"
                ]
              },
              "ownership": {
                "title": "Степень владения",
                "enum": [
                  "Владеем исходным кодом",
                  "Владеем экземпляром",
                  "SaaS",
                  "Система партнера"
                ]
              },
              "performance": {
                "title": "Производительность",
                "type": "string"
              },
              "rto": {
                "title": "RTO (час)",
                "type": "number"
              },
              "rpo": {
                "title": "RPO (час)",
                "type": "number"
              },
              "sla": {
                "title": "Уровень доступности SLA (%)",
                "type": "number"
              },
              "monitoring": {
                "title": "Средства мониторинга",
                "type": "string"
              },
              "external_itsm_id": {
                "title": "ID во внешнем ITSM",
                "description": "Идентификатор IHCI в центальном ITSM Группы компаний",
                "type": "string"
              }
            },
            "type": "object",
            "additionalProperties": false
          },
          "seaf.company.def.app.system": {
            "properties": {
              "type": {
                "title": "Тип системы",
                "type": "string",
                "enum": [
                  "Прикладная система",
                  "DevOps система"
                ]
              },
              "class": {
                "title": "Класс",
                "enum": [
                  "BPM (Business Process Management)",
                  "CRM-аналитический",
                  "CRM-операционный",
                  "ECM (Документооборот)",
                  "RPA (Robotic process automation)",
                  "Workforce Management",
                  "Аналитика данных",
                  "Бизнес-планирование",
                  "Биллинг",
                  "Бухгалтерия и финансы",
                  "Бюджетирование и контроль",
                  "Взаимоотношения с поставщиками",
                  "Гео-информационные системы",
                  "Клиентский профиль (Customer Information File)",
                  "Контакт-центр",
                  "Корпоративная база знаний",
                  "Корпоративная отчетность",
                  "Корпоративный портал",
                  "Маркетинг",
                  "Маркетплейс компании",
                  "Мессенджеры",
                  "Нормативная документация",
                  "Обмен данными с контрагентами",
                  "Получение сведений о юрлицах",
                  "Продуктовая фабрика (основная деятельность)",
                  "Продуктовый каталог",
                  "Регуляторная отчетность",
                  "Сайт компании",
                  "Системы принятия решений",
                  "Скоринг и рейтинг клиентов",
                  "Совместная работа (collaboration)",
                  "Управление активами",
                  "Управление внутрихозяйственной деятельностью",
                  "Управление задачами и проектами",
                  "Управление обучением",
                  "Управление персоналом",
                  "Учет судебных дел",
                  "Финансовый мониторинг и AML",
                  "CMS (Content Management System)",
                  "E-mail",
                  "Service Desk",
                  "Видеосвязь",
                  "Мониторинг",
                  "Рассылка SMS/Push",
                  "Системы генерации документов",
                  "Телефония",
                  "Архитектурный репозиторий",
                  "Бэкапирование и восстановление данных",
                  "Виртуализация",
                  "Контейнеризация",
                  "Логгирование",
                  "Удалённый доступ",
                  "Управление конфигурациями",
                  "Управление облачной инфраструктурой",
                  "Каналы обслуживания клиентов (фронтальные решения)",
                  "BigData",
                  "CDC (Change Data Capture)",
                  "DWH (Хранилище данных)",
                  "ETL",
                  "FTP/SFTP/FTPS серверы",
                  "MDM (Master Data Management)",
                  "Message Queue",
                  "NoSQL СУБД",
                  "OLAP & BI",
                  "Proxy-серверы",
                  "Web-серверы",
                  "Балансировка нагрузки (load balancers)",
                  "Интеграционная шина",
                  "Проверка и очистка данных",
                  "Распределенный кэш",
                  "Реляционные СУБД",
                  "Серверы приложений (Application Servers)",
                  "Файловое хранилище",
                  "Иное"
                ]
              }
            },
            "required": [
              "type",
              "class"
            ]
          },
          "seaf.company.def.cybersec.system": {
            "properties": {
              "type": {
                "title": "Тип системы",
                "type": "string",
                "enum": [
                  "Система кибербезопасности"
                ],
                "default": "Система кибербезопасности"
              },
              "class": {
                "title": "Класс",
                "enum": [
                  "ИБ-Антивирусное ПО",
                  "ИБ-Аудит действий персонала",
                  "ИБ-Аутентификация пользователей",
                  "ИБ-Биометрия",
                  "ИБ-Защита от киберугроз",
                  "ИБ-Защита от сетевых атак",
                  "ИБ-Защита от утечек информации",
                  "ИБ-Защита трафика",
                  "ИБ-Криптография и шифрование",
                  "ИБ-Предотвращение мошенничества",
                  "ИБ-Управление доступом",
                  "ИБ-Управление сертификатами",
                  "ИБ-Управление событиями инф. безопасности",
                  "Иное"
                ]
              }
            },
            "required": [
              "type",
              "class"
            ]
          }
        },
        "patternProperties": {
          "^[a-zA-Z0-9_]{3,}\\.(app_system|tech_system)\\.[a-zA-Z0-9_]*$": {
            "allOf": [
              {
                "$ref": "#/$defs/seaf.company.def.app.system"
              },
              {
                "$ref": "#/$defs/seaf.def.basic_attributes"
              },
              {
                "$ref": "#/$defs/seaf.company.def.system"
              },
              {
                "$ref": "#/$defs/seaf.company.def.criticality_level"
              }
            ]
          },
          "^[a-zA-Z0-9_]{3,}\\.cybersec_system\\.[a-zA-Z0-9_]*$": {
            "allOf": [
              {
                "$ref": "#/$defs/seaf.company.def.cybersec.system"
              },
              {
                "$ref": "#/$defs/seaf.def.basic_attributes"
              },
              {
                "$ref": "#/$defs/seaf.company.def.system"
              }
            ]
          }
        },
        "type": "object",
        "additionalProperties": false
      },
      "title": "Системы",
      "description": "Автоматизированная система (АС) - самостоятельный объект управления в ИТ-процессах, представляющий собой набор разработанных или заимствованных компонентов программного обеспечения, реализующих логически связанный набор функциональности для выполнения необходимых бизнес-задач, а также для поддержки других АС. Аналог уровня L1 C4model\n"
    },
    "seaf.company.sys_components": {
      "schema": {
        "patternProperties": {
          "^[a-zA-Z0-9_]{3,}(\\.[a-zA-Z0-9_]+)+$": {
            "properties": {
              "realizes_system": {
                "title": "Реализует систему",
                "description": "Конструктивной частью какой системы является данный компонент",
                "$ref": "#/$rels/seaf.company.app.systems.system"
              }
            },
            "type": "object",
            "allOf": [
              {
                "$ref": "#/$defs/seaf.def.basic_attributes"
              },
              {
                "$ref": "#/$defs/seaf.def.lifecycle_stage"
              }
            ]
          }
        },
        "type": "object"
      },
      "objects": {
        "sys_component": {
          "route": "/",
          "title": "Компонент системы",
          "symbol": "sys_component"
        }
      },
      "title": "Компоненты системы",
      "description": "Конструктивные (рантайм) компоненты автоматизированной системы. Аналог уровня L2 C4model"
    },
    "seaf.company.ba.clients": {
      "schema": {
        "patternProperties": {
          "^[a-zA-Z0-9_]{3,}(\\.[a-zA-Z0-9_]+)+$": {
            "properties": {
              "is_part_of": {
                "title": "Является частью",
                "description": "Используется для задания древовидной структуры объектов",
                "$ref": "#/$rels/seaf.company.ba.clients.client"
              },
              "type": {
                "title": "Тип клиента",
                "enum": [
                  "Физические лица",
                  "Микро/Малый бизнес",
                  "Крупный и средний бизнес",
                  "Крупнейшие клиенты и финансовые институты",
                  "Сотрудники компании"
                ]
              },
              "count": {
                "title": "Количественная оценка",
                "type": "integer"
              },
              "measure": {
                "title": "Ед. измерения количественной оценки клиентов",
                "type": "string"
              },
              "uses_it_services": {
                "items": {
                  "$ref": "#/$rels/seaf.company.app.services.service"
                },
                "title": "Использует ИТ-сервисы",
                "type": "array"
              }
            },
            "type": "object",
            "$ref": "#/$defs/seaf.def.basic_attributes",
            "required": [
              "type"
            ]
          }
        },
        "type": "object",
        "additionalProperties": false
      },
      "objects": {
        "client": {
          "route": "/",
          "title": "Клиент",
          "symbol": "client"
        }
      },
      "title": "Клиенты",
      "description": "Роль - потребитель продуктов Компании"
    },
