  "kadzo.components": {
    "title": "Технические компоненты",
    "description": "Технический компонент - объект управления в IT-архитектуре, имеющий один или несколько исполняемых экземпляров на вычислительных ресурсах и/или ресурсах хранения данных.",
    "schema": {
      "type": "object",
      "patternProperties": {
        "[a-zA-Z0-9_]*(\\.[a-zA-Z0-9_]*)*$": {
          "type": "object",
          "properties": {
            "interactions": {
              "title": "Исходящие взаимодействия",
              "type": "object",
              "patternProperties": {
                "[a-zA-Z0-9_]*(\\.[a-zA-Z0-9_]*)*$": {
                  "required": [
                    "title"
                  ],
                  "type": "object",
                  "properties": {
                    "title": {
                      "title": "Наименование",
                      "type": "string",
                      "minLength": 2
                    },
                    "description": {
                      "title": "Описание",
                      "type": "string",
                      "minLength": 2
                    },
                    "to": {
                      "title": "Компонент, c которым осуществляется взаимодействие",
                      "type": "string",
                      "__refrel__": "kadzo.components"
                    },
                    "point": {
                      "title": "Точка взаимодействия",
                      "type": "string"
                    }
                  }
                }
              }
            },
            "technical_usage": {
              "title": "Технологические взаимодействия",
              "type": "object",
              "patternProperties": {
                "[a-zA-Z0-9_]*(\\.[a-zA-Z0-9_]*)*$": {
                  "type": "object",
                  "properties": {
                    "title": {
                      "title": "Наименование",
                      "type": "string",
                      "minLength": 2
                    },
                    "to": {
                      "title": "Компонент, c которым осуществляется взаимодействие",
                      "type": "string",
                      "__refrel__": "kadzo.v2023.tech_services"
                    }
                  },
                  "required": [
                    "to"
                  ]
                }
              }
            },
            "title": {
              "title": "Наименование",
              "type": "string",
              "minLength": 2
            },
            "description": {
              "title": "Описание",
              "type": "string",
              "minLength": 2
            },
            "is_part_of": {
              "title": "Логический родитель (объект управления), в состав которого входит технический компонент",
              "type": "string",
              "__var1__": {
                "__refrel__": "kadzo.v2023.systems"
              },
              "__var2__": {
                "__refrel__": "kadzo.v2023.kb_systems"
              },
              "__var3__": {
                "__refrel__": "kadzo.v2023.tech_services"
              }
            }
          }
        }
      }
    },
    "objects": {
