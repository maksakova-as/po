{
  "seaf.ta.components.server": {
    "schema": {
      "patternProperties": {
        "^[a-zA-Z0-9_\\.]*$": {
          "type": "object",
          "properties": {
            "type": "object",
            "sber": {
              "__refdef__": {
                "title": "Расширение описания физических серверов для целей проверки станадртов",
                "type": "object",
                "properties": {
                  "power_module_qty": {
                    "title": "Количество блоков питания",
                    "type": "integer"
                  },
                  "fan_qty": {
                    "title": "Количество кулеров",
                    "type": "integer"
                  },
                  "raid_level": {
                    "title": "Уровени RAID применённые на сервере",
                    "type": "array"
                  },
                  "raid_spare_disks": {
                    "title": "Количество запасных дисков для RAID массивов",
                    "type": "integer"
                  },
                  "rack_mount": {
                    "title": "Стоечное исполнение сервера",
                    "type": "boolean"
                  }
                },
                "required": [
                  "power_module_qty",
                  "fan_qty",
                  "raid_level",
                  "raid_spare_disks",
                  "rack_mount"
                ]
              }
            }
          }
        },
        "^[a-zA-Z0-9_-]*(\\.[a-zA-Z0-9_-]*)*$": {
          "__refdef__": {
            "__refdef__": {
              "type": "object",
              "properties": {
                "title": {
                  "title": "Наименование",
                  "type": "string"
                },
                "description": {
                  "title": "Описание",
                  "type": "string"
                },
                "stand_id": {
                  "title": "Имя стенда внутри окружения",
                  "type": "array",
                  "items": {
                    "__refrel__": "seaf.ta.services.stand"
                  }
                }
              }
            },
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "title": "Server ID",
                    "type": "string"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "Виртуальный"
                    ]
                  },
                  "fqdn": {
                    "title": "Имя сервера FQDN",
                    "type": "string"
                  },
                  "os": {
                    "title": "Операционная система",
                    "type": "object",
                    "properties": {
                      "type": {
                        "title": "Тип ОС",
                        "type": "string",
                        "minlength": 1
                      },
                      "bit": {
                        "title": "Битность ОС",
                        "type": "string",
                        "minLength": 2
                      }
                    }
                  },
                  "cpu": {
                    "title": "Процессор",
                    "type": "object",
                    "properties": {
                      "cores": {
                        "title": "Ядра",
                        "type": "integer",
                        "minlength": 1
                      },
                      "frequency": {
                        "title": "Частота",
                        "type": "integer",
                        "minLength": 0
                      }
                    }
                  },
                  "ram": {
                    "title": "Количество RAM, GB",
                    "type": "integer"
                  },
                  "disks": {
                    "title": "Диски",
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "patternProperties": {
                        "^[a-zA-Z0-9_\\.]*$": {
                          "type": "object",
                          "properties": {
                            "az": {
                              "title": "Зона доступности диска",
                              "type": "string"
                            },
                            "size": {
                              "title": "Размер диска",
                              "type": "string"
                            },
                            "type": {
                              "title": "Тип диска (SAS, SATA, SSD)",
                              "type": "string"
                            },
                            "device": {
                              "title": "Точка монтирования",
                              "type": "string",
                              "minLength": 1
                            }
                          }
                        }
                      }
                    }
                  },
                  "nic_qty": {
                    "title": "Количество NIC",
                    "type": "integer"
                  },
                  "az": {
                    "title": "В какие зоны доступности входит",
                    "type": "array",
                    "items": {
                      "__refrel__": "seaf.ta.services.dc_az"
                    }
                  },
                  "virtualization_id": {
                    "title": "ID кластера виртуализации",
                    "__refrel__": "seaf.ta.services.cluster_virtualization"
                  },
                  "subnets": {
                    "title": "Подсети",
                    "type": "array",
                    "items": {
                      "__refrel__": "seaf.ta.services.network"
                    }
                  }
                },
                "required": [
                  "id",
                  "type",
                  "fqdn",
                  "os",
                  "disks",
                  "cpu",
                  "ram",
                  "nic_qty",
                  "virtualization_id"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "title": "Server ID",
                    "type": "string"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "Физический"
                    ]
                  },
                  "vendor": {
                    "title": "Производитель",
                    "type": "string"
                  },
                  "model": {
                    "title": "Модель",
                    "type": "string"
                  },
                  "fqdn": {
                    "title": "Имя сервера FQDN",
                    "type": "string"
                  },
                  "os": {
                    "title": "Операционная система",
                    "type": "object",
                    "properties": {
                      "type": {
                        "title": "Тип ОС",
                        "type": "string",
                        "minlength": 1
                      },
                      "bit": {
                        "title": "Битность ОС",
                        "type": "string",
                        "minLength": 2
                      }
                    }
                  },
                  "cpu": {
                    "title": "Процессор",
                    "type": "object",
                    "properties": {
                      "cores": {
                        "title": "Ядра",
                        "type": "integer",
                        "minlength": 1
                      },
                      "frequency": {
                        "title": "Частота",
                        "type": "integer",
                        "minLength": 0
                      }
                    }
                  },
                  "ram": {
                    "title": "Количество RAM, GB",
                    "type": "integer"
                  },
                  "disks": {
                    "title": "Диски",
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      ".*": {
                        "type": "object",
                        "properties": {
                          "az": {
                            "title": "Зона доступности диска",
                            "type": "string"
                          },
                          "size": {
                            "title": "Размер диска",
                            "type": "integer"
                          },
                          "type": {
                            "title": "Тип диска (SAS, SATA, SSD)",
                            "type": "string"
                          }
                        }
                      }
                    }
                  },
                  "storage_id": {
                    "title": "Подключенные СХД",
                    "type": "string",
                    "__refrel__": "seaf.ta.components.hw_storage"
                  },
                  "nic_qty": {
                    "title": "Количество NIC",
                    "type": "integer"
                  },
                  "vlan": {
                    "title": "Подключенные VLAN",
                    "type": "array"
                  },
                  "dc_id": {
                    "title": "Имя ЦОД/Серверной комнаты",
                    "__refrel__": "seaf.ta.services.dc"
                  },
                  "office_id": {
                    "title": "Офис",
                    "__refrel__": "seaf.ta.services.office"
                  },
                  "subnets": {
                    "title": "Перечисление связанных сетей",
                    "type": "string",
                    "items": {
                      "__refrel__": "seaf.ta.services.network"
                    }
                  }
                },
                "required": [
                  "id",
                  "type",
                  "vendor",
                  "model",
                  "fqdn",
                  "os",
                  "cpu",
                  "disks",
                  "ram",
                  "nic_qty",
                  "dc_id"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "type": "object"
    },
    "title": "Server",
    "objects": {
      "server": {
        "route": "/",
        "title": "Сервер"
      }
    }
  }
}