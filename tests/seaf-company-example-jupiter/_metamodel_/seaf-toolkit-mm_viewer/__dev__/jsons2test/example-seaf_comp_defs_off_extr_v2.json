                        "Внедрение / Не введена в эксплуатацию",
                        "Опытная эксплуатация",
                        "Промышленная эксплуатация",
                        "Архивная"
                      ]
                    },
                    "live_stage_target": {
                      "title": "Этап жизненного цикла на горизонт планирования",
                      "enum": [
                        "Эскиз",
                        "В разработке / приобретение",
                        "Внедрение / Не введена в эксплуатацию",
                        "Опытная эксплуатация",
                        "Промышленная эксплуатация",
                        "Архивная"
                      ]
                    },
                    "target_status": {
                      "title": "Целевой статус (решение принято)",
                      "enum": [
