{
  "entities": {
    "seaf.ta.components.server": {
      "title": "Server",
      "schema": {
        "$defs": {
          "seaf.ta.components.server_dzo": {
            "title": "Расширение описания физических серверов для целей проверки станадртов",
            "type": "object",
            "properties": {
              "power_module_qty": {
                "title": "Количество блоков питания",
                "type": "integer"
              },
              "fan_qty": {
                "title": "Количество кулеров",
                "type": "integer"
              },
              "raid_level": {
                "title": "Уровени RAID применённые на сервере",
                "type": "array"
              },
              "raid_spare_disks": {
                "title": "Количество запасных дисков для RAID массивов",
                "type": "integer"
              },
              "rack_mount": {
                "title": "Стоечное исполнение сервера",
                "type": "boolean"
              }
            },
            "required": [
              "power_module_qty",
              "fan_qty",
              "raid_level",
              "raid_spare_disks",
              "rack_mount"
            ]
          },
          "seaf.ta.components.server": {
            "$ref": "#/$defs/seaf.ta.components.base.entity",
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "title": "Server ID",
                    "type": "string"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "Виртуальный"
                    ]
                  },
                  "fqdn": {
                    "title": "Имя сервера FQDN",
                    "type": "string"
                  },
                  "os": {
                    "title": "Операционная система",
                    "type": "object",
                    "properties": {
                      "type": {
                        "title": "Тип ОС",
                        "type": "string",
                        "minlength": 1
                      },
                      "bit": {
                        "title": "Битность ОС",
                        "type": "string",
                        "minLength": 2
                      }
                    }
                  },
                  "cpu": {
                    "title": "Процессор",
                    "type": "object",
                    "properties": {
                      "cores": {
                        "title": "Ядра",
                        "type": "integer",
                        "minlength": 1
                      },
                      "frequency": {
                        "title": "Частота",
                        "type": "integer",
                        "minLength": 0
                      }
                    }
                  },
                  "ram": {
                    "title": "Количество RAM, GB",
                    "type": "integer"
                  },
                  "disks": {
                    "title": "Диски",
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "patternProperties": {
                        "^[a-zA-Z0-9_\\.]*$": {
                          "type": "object",
                          "properties": {
                            "az": {
                              "title": "Зона доступности диска",
                              "type": "string"
                            },
                            "size": {
                              "title": "Размер диска",
                              "type": "string"
                            },
                            "type": {
                              "title": "Тип диска (SAS, SATA, SSD)",
                              "type": "string"
                            },
                            "device": {
                              "title": "Точка монтирования",
                              "type": "string",
                              "minLength": 1
                            }
                          }
                        }
                      }
                    }
                  },
                  "nic_qty": {
                    "title": "Количество NIC",
                    "type": "integer"
                  },
                  "az": {
                    "title": "В какие зоны доступности входит",
                    "type": "array",
                    "items": {
                      "$ref": "#/$rels/seaf.ta.services.dc_az.dc_az"
                    }
                  },
                  "virtualization_id": {
                    "title": "ID кластера виртуализации",
                    "$ref": "#/$rels/seaf.ta.services.cluster_virtualization.cluster_virtualization"
                  },
                  "subnets": {
                    "title": "Подсети",
                    "type": "array",
                    "items": {
                      "$ref": "#/$rels/seaf.ta.services.network.network"
                    }
                  }
                },
                "required": [
                  "id",
                  "type",
                  "fqdn",
                  "os",
                  "disks",
                  "cpu",
                  "ram",
                  "nic_qty",
                  "virtualization_id"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "title": "Server ID",
                    "type": "string"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "Физический"
                    ]
                  },
                  "vendor": {
                    "title": "Производитель",
                    "type": "string"
                  },
                  "model": {
                    "title": "Модель",
                    "type": "string"
                  },
                  "fqdn": {
                    "title": "Имя сервера FQDN",
                    "type": "string"
                  },
                  "os": {
                    "title": "Операционная система",
                    "type": "object",
                    "properties": {
                      "type": {
                        "title": "Тип ОС",
                        "type": "string",
                        "minlength": 1
                      },
                      "bit": {
                        "title": "Битность ОС",
                        "type": "string",
                        "minLength": 2
                      }
                    }
                  },
                  "cpu": {
                    "title": "Процессор",
                    "type": "object",
                    "properties": {
                      "cores": {
                        "title": "Ядра",
                        "type": "integer",
                        "minlength": 1
                      },
                      "frequency": {
                        "title": "Частота",
                        "type": "integer",
                        "minLength": 0
                      }
                    }
                  },
                  "ram": {
                    "title": "Количество RAM, GB",
                    "type": "integer"
                  },
                  "disks": {
                    "title": "Диски",
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      ".*": {
                        "type": "object",
                        "properties": {
                          "az": {
                            "title": "Зона доступности диска",
                            "type": "string"
                          },
                          "size": {
                            "title": "Размер диска",
                            "type": "integer"
                          },
                          "type": {
                            "title": "Тип диска (SAS, SATA, SSD)",
                            "type": "string"
                          }
                        }
                      }
                    }
                  },
                  "storage_id": {
                    "title": "Подключенные СХД",
                    "type": "string",
                    "$ref": "#/$rels/seaf.ta.components.hw_storage.hw_storage"
                  },
                  "nic_qty": {
                    "title": "Количество NIC",
                    "type": "integer"
                  },
                  "vlan": {
                    "title": "Подключенные VLAN",
                    "type": "array"
                  },
                  "dc_id": {
                    "title": "Имя ЦОД/Серверной комнаты",
                    "$ref": "#/$rels/seaf.ta.services.dc.dc"
                  },
                  "office_id": {
                    "title": "Офис",
                    "$ref": "#/$rels/seaf.ta.services.office.office"
                  },
                  "subnets": {
                    "title": "Перечисление связанных сетей",
                    "type": "string",
                    "items": {
                      "$ref": "#/$rels/seaf.ta.services.network.network"
                    }
                  }
                },
                "required": [
                  "id",
                  "type",
                  "vendor",
                  "model",
                  "fqdn",
                  "os",
                  "cpu",
                  "disks",
                  "ram",
                  "nic_qty",
                  "dc_id"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "patternProperties": {
          "^[a-zA-Z0-9_\\.]*$": {
            "type": "object",
            "properties": {
              "type": "object",
              "sber": {
                "$ref": "#/$defs/seaf.ta.components.server_dzo"
              }
            }
          },
          "^[a-zA-Z0-9_-]*(\\.[a-zA-Z0-9_-]*)*$": {
            "$ref": "#/$defs/seaf.ta.components.server"
          }
        },
        "type": "object"
      },
      "objects": {
        "server": {
          "route": "/",
          "title": "Сервер"
        }
      }
    }
  }
}